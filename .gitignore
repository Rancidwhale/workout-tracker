# Workout Tracker monorepo: backend/ (FastAPI) + frontend/ (React).
# Language-specific rules are scoped to their folder so they can't match
# files in the other app (e.g. Python's lib/ once hid frontend/src/lib/).
# frontend/.gitignore holds the Node rules.

# --- Secrets & local config (anywhere) ----------------------------------------
.env
.env.*
!.env.example
*.pem

# --- OS & editors (anywhere) --------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# --- Logs (anywhere) ----------------------------------------------------------
*.log

# --- Claude Code local state --------------------------------------------------
.claude/worktrees/
.claude/settings.local.json

# --- Backend (Python) ---------------------------------------------------------
backend/**/__pycache__/
backend/**/*.py[cod]
backend/venv/
backend/.venv/
backend/env/

# Packaging
backend/build/
backend/dist/
backend/*.egg-info/

# Tests, coverage & tooling caches
backend/.pytest_cache/
backend/.coverage
backend/.coverage.*
backend/htmlcov/
backend/coverage.xml
backend/.mypy_cache/
backend/.ruff_cache/
