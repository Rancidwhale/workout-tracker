# Copy to .env (git-ignored) and adjust. Read by docker compose.

# Images to run. Point these at what you built and pushed.
BACKEND_IMAGE=ghcr.io/rancidwhale/workout-tracker-backend:latest
FRONTEND_IMAGE=ghcr.io/rancidwhale/workout-tracker-frontend:latest

# Required: signs JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=

# Database (defaults match the local dev setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workout_tracker

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# WEB_CONCURRENCY=2
